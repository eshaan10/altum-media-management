# Copy to .env.local for local dev; add the same vars in Vercel → Project → Settings → Environment Variables.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=YOUR_KEY_HERE

# Where contact-form submissions are delivered (comma-separate for multiple).
CONTACT_TO_EMAIL=dmclaughlin@altummediamanagement.com

# Sender address. Must be on a domain verified in Resend (e.g. altummediamanagement.com).
# Until the domain is verified, use "Altum Website <onboarding@resend.dev>" — note Resend
# only lets that test sender deliver to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=Altum Media Management <website@altummediamanagement.com>
